{
  "name": "carbuyhelper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "scrape": "node --disable-warning=ExperimentalWarning scraper/run.js",
    "export": "node --disable-warning=ExperimentalWarning scraper/export.js",
    "refresh": "npm run scrape && npm run export",
    "test": "node --disable-warning=ExperimentalWarning --test \"scraper/**/*.test.js\" \"src/**/*.test.js\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
